{
    "$schema": "https://raw.githubusercontent.com/Laravel-Lang/mona/main/resources/laravel-lang.schema.json",
    "plugins": [
        {
            "files": [
                {
                    "source": "http-statuses.php",
                    "target": "{locale}/http-statuses.php"
                },
                {
                    "source": "http-statuses.json",
                    "target": "{locale}.json"
                }
            ]
        }
    ]
}
